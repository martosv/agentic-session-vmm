{
  "name": "GitHub Agentic Workflows Workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:latest": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ritwickdey.LiveServer"
      ]
    },
    "codespaces": {
      "repositories": {
        "STUDENT_OWNER/STUDENT_REPOSITORY": {
          "permissions": {
            "actions": "write",
            "checks": "write",
            "contents": "write",
            "discussions": "write",
            "issues": "write",
            "pull_requests": "write",
            "workflows": "write"
          }
        }
      }
    }
  }
}
